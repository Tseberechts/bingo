{
  "name": "bingo",
  "version": "1.0.1",
  "description": "Desktop bingo caller for live events (Windows, macOS, Linux)",
  "main": "main.js",
  "scripts": {
    "prestart": "npm run build:css",
    "start": "concurrently -k \"npm run watch:css\" \"electron .\"",
    "build:css": "npx @tailwindcss/cli -i ./styles/input.css -o ./styles/output.css",
    "watch:css": "npx @tailwindcss/cli -i ./styles/input.css -o ./styles/output.css --watch",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "version:suggest": "node scripts/suggest-version.js",
    "dist": "npm run build:css && node scripts/run-dist.js --win --mac --linux",
    "dist:win": "npm run build:css && node scripts/run-dist.js --win",
    "dist:mac": "npm run build:css && node scripts/run-dist.js --mac",
    "dist:linux": "npm run build:css && node scripts/run-dist.js --linux",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tseberechts/bingo.git"
  },
  "keywords": [
    "bingo",
    "electron"
  ],
  "author": "Thomas Seberechts <thomas@seberechts.eu>",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bugs": {
    "url": "https://github.com/Tseberechts/bingo/issues"
  },
  "homepage": "https://github.com/Tseberechts/bingo#readme",
  "build": {
    "appId": "com.tseberechts.bingo",
    "productName": "Bingo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!release/**",
      "!test/**",
      "!.github/**",
      "!.cache/**",
      "!sponsors/**",
      "!eslint.config.js",
      "!commitlint.config.js",
      "!.husky/**",
      "!scripts/**",
      "!**/*.md",
      "README.md"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.entertainment",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Tseberechts",
        "repo": "bingo"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/cli": "^4.1.17",
    "concurrently": "^9.2.1",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "conventional-recommended-bump": "^9.0.0",
    "electron": "^39.2.3",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "tailwindcss": "^4.1.17"
  }
}
